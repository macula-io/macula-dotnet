<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Macula</PackageId>
    <RootNamespace>Macula</RootNamespace>
    <AssemblyName>Macula</AssemblyName>
    <Version>0.10.0</Version>
    <Description>.NET client for the Macula mesh: TLS 1.3 with a hybrid post-quantum key exchange, ML-DSA-87 identities, signed calls, replies and publications, handshake v5 (sessions bound to their TLS channel), and end-to-end sealing of calls, streams and realm groups with the caller's seal report. Node keys, a pool of station links, calls and streams by direct dial, serving in a node's own namespace or under an org, publish/subscribe and sealed group publish/subscribe, node-served content and the DHT. Built on libmacula, macula-go behind a C ABI, shipped in the package for Linux (x64, arm64), macOS (x64, arm64) and Windows (x64).</Description>
    <Authors>Macula</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/macula-io/macula-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/macula-io/macula-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>macula;mesh;quic;rpc;pubsub;post-quantum;ml-dsa;ml-kem;dotnet;csharp</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    libmacula for each runtime, from native/runtimes/<rid>/native/ (fetched
    and verified by scripts/fetch_libmacula.sh, or built for this machine by
    scripts/build_libmacula.sh). Packed at the same path, which NuGet resolves
    per runtime; copied to this project's output for its own tests.
  -->
  <ItemGroup>
    <None Include="../../native/runtimes/**/native/*" Pack="true" PackagePath="runtimes" LinkBase="runtimes"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Macula.Tests" />
  </ItemGroup>

  <!--
    The ABI and the wire this binding is written against, read from the header
    the release ships (abi/macula.h, at abi/MACULA_GO_REF) rather than written
    as a literal here: a header that moves to another ABI moves this binding
    with it in the same commit, and nothing can edit one and forget the other.
    scripts/fetch_libmacula.sh refuses a release whose header is not this one.
  -->
  <PropertyGroup>
    <MaculaAbiHeader>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../abi/macula.h'))</MaculaAbiHeader>
  </PropertyGroup>

  <!--
    IntermediateOutputPath is set when the SDK's targets are imported, after
    this file is read, so the source's path is spelled out in the target's
    Inputs/Outputs and built inside it rather than in an outer PropertyGroup.
  -->
  <Target Name="GenerateMaculaAbi" BeforeTargets="CoreCompile"
          Inputs="$(MaculaAbiHeader)" Outputs="$(IntermediateOutputPath)MaculaAbi.g.cs">
    <PropertyGroup>
      <_MaculaSource>$(IntermediateOutputPath)MaculaAbi.g.cs</_MaculaSource>
      <_MaculaHeader>$([System.IO.File]::ReadAllText('$(MaculaAbiHeader)'))</_MaculaHeader>
      <_MaculaAbi>$([System.Text.RegularExpressions.Regex]::Match($(_MaculaHeader), '#define MACULA_ABI_VERSION (\d+)').Groups[1].Value)</_MaculaAbi>
      <_MaculaWire>$([System.Text.RegularExpressions.Regex]::Match($(_MaculaHeader), '#define MACULA_WIRE_VERSION "([^"]+)"').Groups[1].Value)</_MaculaWire>
    </PropertyGroup>
    <Error Condition="'$(_MaculaAbi)' == '' or '$(_MaculaWire)' == ''"
           Text="$(MaculaAbiHeader) does not define MACULA_ABI_VERSION and MACULA_WIRE_VERSION" />
    <ItemGroup>
      <_MaculaAbiLines Include="// &lt;auto-generated /&gt; The ABI and the wire, read from abi/macula.h at build time." />
      <_MaculaAbiLines Include="// Editing this file does nothing: the header is the source, and GenerateMaculaAbi writes this." />
      <_MaculaAbiLines Include="namespace Macula.Native%3B" />
      <_MaculaAbiLines Include="internal static partial class Libmacula" />
      <_MaculaAbiLines Include="{" />
      <_MaculaAbiLines Include="    internal const int AbiVersion = $(_MaculaAbi)%3B" />
      <_MaculaAbiLines Include="    internal const string WireVersion = &quot;$(_MaculaWire)&quot;%3B" />
      <_MaculaAbiLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_MaculaSource)" Lines="@(_MaculaAbiLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_MaculaSource)" />
      <FileWrites Include="$(_MaculaSource)" />
    </ItemGroup>
  </Target>

</Project>
