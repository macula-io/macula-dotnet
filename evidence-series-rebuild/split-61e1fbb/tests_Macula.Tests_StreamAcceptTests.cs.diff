+using System.Runtime.Versioning;
+using System.Security.Cryptography;
+using Macula.Connection;
+using Macula.Frame;
+using Macula.Identity;
+using Macula.Streaming;
+
+namespace Macula.Tests;
+
+/// <summary>
+/// A provider opening an inbound dedicated stream, over a stream that serves
+/// the opener's first bytes and records how it was aborted. The names match
+/// the Go, Rust and Erlang tests.
+/// </summary>
+[SupportedOSPlatform("linux")]
+[SupportedOSPlatform("macos")]
+[SupportedOSPlatform("windows")]
+public class StreamAcceptTests
+{
+    private static readonly byte[] Realm = new byte[32];
+
+    [Fact]
+    public async Task A_stream_open_not_signed_by_its_caller_is_refused()
+    {
+        var caller = KeyPair.Generate();
+        var firstBytes = new (byte[] Bytes, DropReason Reason)[]
+        {
+            (WireCodec.Encode(Envelope.Sign(StreamOpen(caller, Value.Null), KeyPair.Generate())), DropReason.InvalidSignature),
+            (WireCodec.Encode(StreamOpen(caller, Value.Null)), DropReason.Unsigned),
+            (WireCodec.Encode(Value.Map([new(Value.Text("frame_type"), Value.Text("call"))])), DropReason.NotAStreamOpen),
+            // A one-byte frame whose CBOR initial byte uses a reserved value.
+            ([0, 0, 0, 1, 0x1C], DropReason.Malformed),
+        };
+
+        foreach (var (bytes, reason) in firstBytes)
+        {
+            var opener = new OpenerStream(bytes);
+
+            var inbound = await StreamHandle.OpenInboundAsync(opener.Frames(), CancellationToken.None);
+
+            Assert.Null(inbound.Opened);
+            Assert.Equal(reason, inbound.Reason);
+            Assert.Equal(StreamHandle.RefusedStreamCode, opener.AbortedWith);
+            Assert.Empty(opener.Written);
+        }
+
+        var genuine = new OpenerStream(WireCodec.Encode(Envelope.Sign(StreamOpen(caller, Value.Null), caller)));
+        var opened = await StreamHandle.OpenInboundAsync(genuine.Frames(), CancellationToken.None);
+        Assert.True(opened.Opened.HasValue);
+        Assert.Equal(caller.NodeId(), opened.Opened.Value.Info.Caller);
+        Assert.Null(genuine.AbortedWith);
+    }
+
+    [Fact]
+    public async Task A_refused_stream_writes_its_error_then_finishes_and_stops_reading()
+    {
+        var caller = KeyPair.Generate();
+        var opener = new OpenerStream(WireCodec.Encode(Envelope.Sign(StreamOpen(caller, Value.Null), caller)));
+        var inbound = await StreamHandle.OpenInboundAsync(opener.Frames(), CancellationToken.None);
+        Assert.True(inbound.Opened.HasValue);
+
+        await inbound.Opened.Value.Handle.RefuseAsync("unauthorized", "not authorized for this procedure", KeyPair.Generate());
+
+        var written = Assert.IsType<Decoded.Frame>(WireCodec.Decode(opener.Written));
+        Assert.Equal(opener.Written.Length, written.Consumed);
+        var error = Assert.IsType<StreamEvent.Error>(StreamFrameParsing.ParseStreamEvent(written.Value));
+        Assert.Equal("unauthorized", error.Code);
+        Assert.Equal("not authorized for this procedure", error.Message);
+        Assert.Equal(StreamHandle.RefusedStreamCode, opener.FinishedAndStoppedWith);
+        Assert.Null(opener.AbortedWith);
+    }
+
+    [Fact]
+    public async Task A_stream_open_threads_its_caller_into_the_args()
+    {
+        var caller = KeyPair.Generate();
+        var claimed = KeyPair.Generate().NodeId();
+        var args = Value.Map([new(Value.Text("n"), Value.Int(21)), new(Value.Text("caller"), Value.Bytes(claimed))]);
+        var opener = new OpenerStream(WireCodec.Encode(Envelope.Sign(StreamOpen(caller, args), caller)));
+
+        var inbound = await StreamHandle.OpenInboundAsync(opener.Frames(), CancellationToken.None);
+
+        Assert.True(inbound.Opened.HasValue);
+        var seen = Assert.IsType<Value.MapValue>(inbound.Opened.Value.Info.Args);
+        Assert.Equal(caller.NodeId(), Assert.IsType<Value.BytesValue>(seen.Get("caller")).Value);
+        Assert.Equal(Value.Int(21), seen.Get("n"));
+    }
+
+    private static Value.MapValue StreamOpen(KeyPair caller, Value args) => StreamOpenFrame.Build(new StreamOpenSpec
+    {
+        StreamId = RandomNumberGenerator.GetBytes(16),
+        Procedure = "app/stream",
+        Realm = Realm,
+        Mode = StreamMode.ServerStream,
+        Args = args,
+        DeadlineMs = 0,
+        Caller = caller.NodeId(),
+    });
+
+    /// <summary>
+    /// The provider's end of a stream an opener started with some bytes: reads
+    /// serve those bytes, writes are kept, and an abort is recorded.
+    /// </summary>
+    private sealed class OpenerStream(byte[] first) : Stream
+    {
+        private readonly MemoryStream _incoming = new(first);
+        private readonly MemoryStream _written = new();
+
+        internal long? AbortedWith { get; private set; }
+
+        internal long? FinishedAndStoppedWith { get; private set; }
+
+        internal byte[] Written => _written.ToArray();
+
+        internal FrameStream Frames() => new(this, new FrameStream.StreamEnds(
+            code =>
+            {
+                AbortedWith = code;
+                return ValueTask.CompletedTask;
+            },
+            code =>
+            {
+                FinishedAndStoppedWith = code;
+                return ValueTask.CompletedTask;
+            }));
+
+        public override ValueTask<int> ReadAsync(Memory<byte> buffer, CancellationToken cancellationToken = default) =>
+            ValueTask.FromResult(_incoming.Read(buffer.Span));
+
+        public override ValueTask WriteAsync(ReadOnlyMemory<byte> buffer, CancellationToken cancellationToken = default)
+        {
+            _written.Write(buffer.Span);
+            return ValueTask.CompletedTask;
+        }
+
+        public override bool CanRead => true;
+        public override bool CanSeek => false;
+        public override bool CanWrite => true;
+        public override long Length => throw new NotSupportedException();
+        public override long Position { get => throw new NotSupportedException(); set => throw new NotSupportedException(); }
+        public override void Flush() { }
+        public override int Read(byte[] buffer, int offset, int count) => _incoming.Read(buffer, offset, count);
+        public override long Seek(long offset, SeekOrigin origin) => throw new NotSupportedException();
+        public override void SetLength(long value) => throw new NotSupportedException();
+        public override void Write(byte[] buffer, int offset, int count) => _written.Write(buffer, offset, count);
+    }
+}
